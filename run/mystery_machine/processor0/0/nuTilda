FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-05;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-05;
    }
    outlet
    {
        type            zeroGradient;
    }
    tunnelWalls
    {
        type            zeroGradient;
    }
    mysteryMachine
    {
        type            zeroGradient;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform 1e-05;
    }
}


