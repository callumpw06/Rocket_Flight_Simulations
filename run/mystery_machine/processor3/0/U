FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -520);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<vector> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    tunnelWalls
    {
        type            slip;
    }
    mysteryMachine
    {
        type            noSlip;
    }
    procBoundary3to0
    {
        type            processor;
        value           uniform (0 0 -520);
    }
    procBoundary3to1
    {
        type            processor;
        value           uniform (0 0 -520);
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform (0 0 -520);
    }
}


